# ============================================================
#  AI 国际象棋分析 Agent —— 环境变量示例
#  复制为 .env 后按需修改。.env 已在 .gitignore 中，不会入库。
# ============================================================

# ---------- Stockfish 引擎 ----------
# 留空则自动使用 engine/stockfish/ 下对应平台的二进制
# 手动指定示例（Windows）: STOCKFISH_PATH=F:/tools/stockfish/stockfish.exe
STOCKFISH_PATH=

# ---------- MCP 工具服务 ----------
MCP_HOST=0.0.0.0
MCP_PORT=9002

# ---------- Dify 后端 API ----------
# 在 Dify 应用「访问点 → 后端服务 API」处获取
DIFY_API_BASE=http://localhost:50001/v1
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 模型：本地 Ollama ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---------- 模型：云端 OpenAI 兼容接口（示例为硅基流动）----------
# 注意：模型 ID 必须带组织前缀，如 Qwen/Qwen3.5-27B
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_CHAT_MODEL=Qwen/Qwen3.5-27B

# ---------- RagFlow 外部知识库 ----------
RAGFLOW_BASE_URL=http://localhost:50003
RAGFLOW_API_KEY=ragflow-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RAGFLOW_DATASET_ID=
